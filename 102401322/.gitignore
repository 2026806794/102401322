# Python 运行时产生的文件
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 覆盖率工具的中间文件（报告本身在 output/htmlcov，那个要交，见下面）
.coverage
coverage.xml
/htmlcov/

# 运行日志
logs/

# 剖析工具的原始数据（output/performance 下的要交，见下面）
.prof
*.prof

# 爬取的弹幕原始缓存有 27MB，太大了不入库；想复现就重新爬一遍
data/raw/danmaku/*.json
# 清洗后的弹幕明细（19MB）入库，这样 clone 下来就能直接跑 analyze 和 visualize，
# 不用重新爬 40 分钟

# 下面这些是要交的，别被上面的规则误伤
!output/performance/*.prof
!output/htmlcov/**
